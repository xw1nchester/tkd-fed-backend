model Tournament {
    id                    Int                 @id @default(autoincrement())
    name                  String
    logoId                Int?                @map("logo_id")
    logo                  File?               @relation("TournamentLogo", fields: [logoId], references: [id], onDelete: SetNull)
    bannerId              Int?                @map("banner_id")
    banner                File?               @relation("TournamentBanner", fields: [bannerId], references: [id], onDelete: SetNull)
    startDate             DateTime            @map("start_date")
    endDate               DateTime            @map("end_date")
    maxParticipants       Int?                @map("max_participants")
    acceptedAthletesCount Int                 @default(0) @map("accepted_athletes_count")
    city                  String
    address               String
    organizer             String?
    chiefSecretary        String?             @map("chief_secretary")
    chiefJudge            String?             @map("chief_judge")
    contacts              String?
    description           String?
    isPublished           Boolean             @default(false) @map("is_published")
    creatorId             Int                 @map("creator_id")
    creator               User                @relation("TournamentCreator", fields: [creatorId], references: [id])
    createdAt             DateTime            @default(now()) @map("created_at")
    updatedAt             DateTime            @updatedAt @map("updated_at")
    tournamentRequests    TournamentRequest[]
    files                 TournamentFile[]

    @@map("tournaments")
}

model TournamentFile {
    id           Int        @id @default(autoincrement())
    tournamentId Int        @map("tournament_id")
    tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
    name         String?
    fileId       Int        @map("file_id")
    file         File       @relation(fields: [fileId], references: [id], onDelete: Cascade)
    createdAt    DateTime   @default(now()) @map("created_at")

    @@map("tournament_files")
}

model TournamentRequest {
    id           Int                        @id @default(autoincrement())
    tournamentId Int                        @map("tournament_id")
    tournament   Tournament                 @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
    trainerId    Int                        @map("trainer_id")
    trainer      User                       @relation("TrainerTournamentRequests", fields: [trainerId], references: [id])
    organization String
    approvalOrganizationLine1 String?       @map("approval_organization_line_1")
    approvalOrganizationLine2 String?       @map("approval_organization_line_2")
    approvalPersonName        String?       @map("approval_person_name")
    athleteCity               String?       @map("athlete_city")
    athleteFederalDistrict    String?       @map("athlete_federal_district")
    athleteSportsSociety      String?       @map("athlete_sports_society")
    teamRepresentativeName    String?       @map("team_representative_name")
    isAccepted   Boolean                    @default(false) @map("is_accepted")
    createdAt    DateTime                   @default(now()) @map("created_at")
    updatedAt    DateTime                   @updatedAt @map("updated_at")
    athletes     TournamentRequestAthlete[]

    @@map("tournament_requests")
}

model TournamentRequestAthlete {
    id               Int               @id @default(autoincrement())
    requestId        Int               @map("request_id")
    request          TournamentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
    athleteId        Int               @map("athlete_id")
    athlete          User              @relation(fields: [athleteId], references: [id])
    weightCategoryId Int               @map("weight_category_id")
    weightCategory   WeightCategory    @relation(fields: [weightCategoryId], references: [id])

    @@map("tournament_request_athletes")
}
